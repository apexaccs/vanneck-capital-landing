[Unit]
Description=Vanneck Capital backend (forms and call bookings -> Telegram, newsletter -> Resend)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/vanneck-capital-landing/backend
EnvironmentFile=/var/www/vanneck-capital-landing/backend/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
User=www-data
NoNewPrivileges=true
PrivateTmp=true
# /var/lib/vanneck-backend: bookings (guest name/email for follow-up emails,
# deleted two days after the call); only readable by www-data
StateDirectoryMode=0700
StateDirectory=vanneck-backend

[Install]
WantedBy=multi-user.target
