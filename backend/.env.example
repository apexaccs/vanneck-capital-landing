PORT=3000

# @BotFather -> create bot -> token. Add the bot as admin of the target
# channel, then set TELEGRAM_CHAT_ID to the channel's @username (if public)
# or its numeric chat id (if private).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# resend.com -> API Keys -> create. Needs a verified sending domain and an
# Audience created in the Resend dashboard (Audiences -> Create Audience);
# its id goes in RESEND_AUDIENCE_ID.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Call booking (/calls/). Google Calendar is only read, never written.
# Google Cloud -> new project -> enable "Google Calendar API" -> IAM & Admin ->
# Service accounts -> create -> Keys -> add key (JSON). Put the JSON file outside
# the web root, e.g. /etc/vanneck-backend/google-sa.json (owner www-data, 600).
# Share two calendars with the service account's e-mail address:
#   - a dedicated "call hours" calendar whose events are the windows when calls
#     can be booked (usually recurring): "See all event details";
#   - your main calendar: "See only free/busy (hide details)".
GOOGLE_SA_KEY_FILE=/etc/vanneck-backend/google-sa.json
GOOGLE_AVAILABILITY_CALENDAR_ID=
# comma-separated; usually just your main calendar id (your Gmail address)
GOOGLE_BUSY_CALENDAR_IDS=
# optional tuning (defaults shown)
CALLS_MIN_NOTICE_HOURS=12
CALLS_HORIZON_DAYS=21
CALLS_BUFFER_MINUTES=15
CALLS_STEP_MINUTES=30
