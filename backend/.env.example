PORT=3000

# @BotFather -> create bot -> token. Add the bot as admin of the target
# channel, then set TELEGRAM_CHAT_ID to the channel's @username (if public)
# or its numeric chat id (if private).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# resend.com -> API Keys -> create. Needs a verified sending domain and an
# Audience created in the Resend dashboard (Audiences -> Create Audience);
# its id goes in RESEND_AUDIENCE_ID.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Booking emails (confirmation, day-before reminder, meeting link) are sent
# from this address; its domain must be verified in Resend (Domains).
RESEND_FROM=Vanneck Capital <calls@vanneck.xyz>
# optional: where guests' replies go (leave empty for no-reply)
RESEND_REPLY_TO=

# Telegram users allowed to use the bot (add meeting links, resend emails),
# comma-separated numeric ids. Write /start to the bot to see your id.
TELEGRAM_ADMIN_IDS=

# Call booking (/calls/). Google Calendar is only read, never written.
# Google Cloud -> new project -> enable "Google Calendar API" -> IAM & Admin ->
# Service accounts -> create -> Keys -> add key (JSON). Put the JSON file outside
# the web root, e.g. /etc/vanneck-backend/google-sa.json (owner www-data, 600).
# Working hours: either list them here (simplest) ...
#   CALLS_TIMEZONE is an IANA zone; days Mon..Sun; several ranges per day with ","
CALLS_TIMEZONE=Europe/Amsterdam
CALLS_HOURS=Mon 18:00-20:30; Tue 20:00-21:30; Wed 17:00-19:30; Thu 20:00-21:30; Fri 17:00-20:30; Sat 13:00-19:30
# ... or leave CALLS_HOURS empty and keep them as events in a dedicated
# "call hours" calendar shared with the service account ("See all event details"):
GOOGLE_AVAILABILITY_CALENDAR_ID=
# Busy time: share your main calendar with the service account's e-mail address
# as "See only free/busy (hide details)".
GOOGLE_SA_KEY_FILE=/etc/vanneck-backend/google-sa.json
# comma-separated; usually just your main calendar id (your Gmail address)
GOOGLE_BUSY_CALENDAR_IDS=
# optional tuning (defaults shown)
CALLS_MIN_NOTICE_HOURS=12
CALLS_HORIZON_DAYS=21
CALLS_BUFFER_MINUTES=15
CALLS_STEP_MINUTES=30
