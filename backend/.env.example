PORT=3000

# @BotFather -> create bot -> token. Add the bot as admin of the target
# channel, then set TELEGRAM_CHAT_ID to the channel's @username (if public)
# or its numeric chat id (if private).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# resend.com -> API Keys -> create. Needs a verified sending domain and an
# Audience created in the Resend dashboard (Audiences -> Create Audience);
# its id goes in RESEND_AUDIENCE_ID.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
